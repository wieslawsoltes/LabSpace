<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(LabSpaceDesktopOnly)' == 'true'">net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType><UnoSingleProject>true</UnoSingleProject><UnoFeatures>SkiaRenderer;</UnoFeatures>
    <ApplicationTitle>LabSpace</ApplicationTitle><ApplicationId>io.github.wieslawsoltes.labspace</ApplicationId>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion><ApplicationVersion>2</ApplicationVersion>
    <ApplicationPublisher>LabSpace contributors</ApplicationPublisher><Description>Graphical instrumentation studio for desktop and browser.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><IsPackable>false</IsPackable>
    <UnoDisableHotDesign>true</UnoDisableHotDesign><UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <RunAOTCompilation>false</RunAOTCompilation><WasmShellGenerateAOTProfile>false</WasmShellGenerateAOTProfile>
    <SkiaSharpVersion>3.119.4</SkiaSharpVersion>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../LabSpace.Workbench/LabSpace.Workbench.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'"><EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/Storage.js" /></ItemGroup>
</Project>
